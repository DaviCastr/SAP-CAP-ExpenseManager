{
    "requires": {
        "auth": {
            "kind": "custom",
            "impl": "srv/auth/app-auth"
        }
    },
    "[development]":{
        "requires": {
            "db": {
                "credentials": {
                    "database": ":memory:"
                },
                "kind": "sqlite"
            }
        }
    },
    "[production]": {
        "requires": {
            "db":{
                "kind": "hana"
            }
        },
        "hana": {
            "deploy-format": "hdbtable"
        }
    }

}