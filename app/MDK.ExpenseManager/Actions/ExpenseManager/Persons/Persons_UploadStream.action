{
    "_Type": "Action.Type.ODataService.UploadStream",
    "Target": {
        "Service": "/ExpenseManager/Services/ExpenseManager.service",
        "EntitySet": "Persons",
        "ReadLink": "{@odata.readLink}"
    },
    "Properties": {
        "Image": "#Control:Image/#Value"
    },
    "ShowActivityIndicator": true,
    "ActionResult": {
        "_Name": "uploadstream"
    },
    "OnSuccess": "/ExpenseManager/Actions/UploadStreamSuccessMessage.action",
    "OnFailure": "/ExpenseManager/Actions/UploadStreamFailureMessage.action"
}