{
    "name": "GestorDeGastos",
    "version": "1.0.0",
    "description": "Gestor de Gastos",
    "dependencies": {
        "@cap-js/hana": "^2.2.0",
        "@sap/cds": "^9.2.0",
        "@sap/xssec": "^4.9.1",
        "express": "^4.21.2",
        "git-commit-msg-linter": "^5.0.8",
        "passport": "^0.7.0"
    },
    "devDependencies": {
        "@cap-js/cds-typer": "^0.38.0",
        "@cap-js/cds-types": "^0.15.0",
        "@cap-js/sqlite": "^2",
        "@sap/dev-cap-tools": "^1.31.0",
        "@types/node": "^25.2.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "cds-serve",
        "dev": "DEBUG=db cds-tsx watch",
        "start-local": "npm run generate-entry-point && npm run cds-watch",
        "generate-entry-point": "dev-cap-tools gen-entrypoint",
        "cds-watch": "cds watch --open"
    },
    "private": true,
    "cds": {
        "requires": {
            "[production]": {
                "db": "hana",
                "auth": "xsuaa"
            },
            "auth": {
                "[development]": {
                    "kind": "dummy"
                },
                "[production]": {
                    "kind": "xsuaa"
                }
            }
        }
    },
    "lcap": true
}
