{
    "name": "ExpenseManager",
    "version": "1.0.0",
    "description": "Gestor de Gastos",
    "dependencies": {
        "@cap-js/hana": "^2.2.0",
        "@sap/cds": "^9.2.0",
        "@sap/mdk-tools": "^1.15.0",
        "@sap/xssec": "^4.9.1",
        "@sweet-monads/either": "^3.3.1",
        "adm-zip": "^0.5.17",
        "axios": "^1.15.0",
        "decimal.js": "^10.6.0",
        "exceljs": "^4.4.0",
        "express": "^4.21.2",
        "fs": "^0.0.1-security",
        "git-commit-msg-linter": "^5.0.8",
        "handlebars": "^4.7.9",
        "nodemailer": "^8.0.5",
        "passport": "^0.7.0",
        "pdfkit": "^0.18.0"
    },
    "devDependencies": {
        "@cap-js/cds-typer": "^0.38.0",
        "@cap-js/cds-types": "^0.15.0",
        "@cap-js/sqlite": "^2",
        "@sap/dev-cap-tools": "^1.31.0",
        "@types/adm-zip": "^0.5.8",
        "@types/exceljs": "^0.5.3",
        "@types/node": "^25.2.1",
        "@types/nodemailer": "^8.0.0",
        "@types/pdfkit": "^0.17.6",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "cds-serve",
        "dev": "DEBUG=db cds-tsx watch",
        "start-local": "npm run generate-entry-point && npm run cds-watch",
        "generate-entry-point": "dev-cap-tools gen-entrypoint",
        "cds-watch": "cds watch --open"
    },
    "private": true,
    "cds": {
        "requires": {
            "[development]": {
                "requires": {
                    "db": {
                        "credentials": {
                            "database": ":memory:"
                        },
                        "kind": "sqlite"
                    },
                    "auth": {
                        "kind": "basic",
                        "users": {
                            "davi": {
                                "password": "123456",
                                "roles": [
                                    "admin"
                                ],
                                "attr": {
                                    "id": 1,
                                    "groups": [
                                        "group1",
                                        "group2"
                                    ]
                                }
                            },
                            "beatriz": {
                                "password": "123456",
                                "roles": [
                                    "read_only_user"
                                ],
                                "attr": {
                                    "id": 2,
                                    "groups": [
                                        "group1"
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "[production]": {
                "requires": {
                    "db": {
                        "kind": "hana"
                    },
                    "uaa": {
                        "kind": "xsuaa"
                    }
                },
                "hana": {
                    "deploy-format": "hdbtable"
                }
            }
        }
    },
    "lcap": true
}
